def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=f"Render {TEMPLATE_ID} with Science Palette Studio colors")
    parser.add_argument("--data-file", default=CONFIG["data_file"])
    parser.add_argument("--output-dir", default=str(Path(__file__).resolve().parent / "rendered"))
    parser.add_argument("--palette-id", default=CONFIG["palette_id"])
    parser.add_argument("--dpi", type=int, default=CONFIG["dpi"])
    parser.add_argument("--formats", default=",".join(CONFIG["output_formats"]))
    return parser.parse_args()


def load_rows(path: str | Path) -> list[dict[str, str]]:
    source = Path(path).expanduser().resolve()
    if not source.is_file():
        raise FileNotFoundError(f"Data file not found: {source}")
    text = source.read_text(encoding="utf-8-sig")
    delimiter = "\t" if source.suffix.lower() == ".tsv" else ","
    try:
        delimiter = csv.Sniffer().sniff(text[:8192], delimiters=",\t;").delimiter
    except csv.Error:
        pass
    reader = csv.DictReader(text.splitlines(), delimiter=delimiter)
    rows = [{str(key): str(value or "") for key, value in row.items()} for row in reader]
    filters = CONFIG["encoding"].get("filter", {})
    if filters:
        if not isinstance(filters, dict) or any(k not in (reader.fieldnames or []) for k in filters):
            raise ValueError("筛选条件引用了未知列。")
        rows = [r for r in rows if all(str(r[k]) in {str(v) for v in (value if isinstance(value, list) else [value])}
                                       for k, value in filters.items())]
    if not rows:
        raise ValueError(f"Data file has no rows: {source}")
    return rows


def require_column(rows: list[dict[str, str]], name: str) -> list[str]:
    if not name or name not in rows[0]:
        raise KeyError(f"Required column is missing: {name}")
    return [row[name] for row in rows]


def numeric(values: list[str], name: str) -> np.ndarray:
    try:
        result = np.asarray([float(value) for value in values], dtype=float)
    except ValueError as exc:
        raise ValueError(f"Column {name} contains a non-numeric value") from exc
    if not np.all(np.isfinite(result)):
        raise ValueError(f"Column {name} contains a non-finite value")
    return result


def ordered_unique(values: list[str]) -> list[str]:
    return list(dict.fromkeys(values))


