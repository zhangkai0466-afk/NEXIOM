def render(data_file: str, output_dir: str, palette_id: str, formats: list[str], dpi: int) -> list[Path]:
    rows, encoding = load_rows(data_file), CONFIG["encoding"]
    category_name, value_name = encoding["category_column"], encoding["value_column"]
    categories = require_column(rows, category_name)
    values = numeric(require_column(rows, value_name), value_name)
    group_name = str(encoding.get("group_column", ""))
    groups = require_column(rows, group_name) if group_name else ["数据"] * len(rows)
    category_order, group_order = ordered_unique(categories), ordered_unique(groups)
    palette = setup_style(palette_id)
    fig, ax = new_axes(palette)
    apply_axis_layer(ax, encoding)
    x = np.arange(len(category_order), dtype=float)
    width = min(0.78 / max(1, len(group_order)), 0.34)
    for index, group in enumerate(group_order):
        heights = []
        for category in category_order:
            selected = [values[pos] for pos in range(len(rows)) if categories[pos] == category and groups[pos] == group]
            heights.append(float(np.mean(selected)) if selected else 0.0)
        offset = (index - (len(group_order) - 1) / 2) * width
        ax.bar(x + offset, heights, width=width * 0.84, color=bar_face_color(palette, index),
               edgecolor=bar_edge_color(palette, index), linewidth=0.9, label=group, zorder=3)
        summary = encoding.get("summary_range_columns", {})
        if summary:
            for column in summary.values(): require_column(rows, column)
            for xpos, category, height in zip(x + offset, category_order, heights):
                selected = [row for pos, row in enumerate(rows) if categories[pos] == category and groups[pos] == group]
                if len(selected) != 1: raise ValueError("摘要区间要求每个类别—组只有一行，不能平均多个区间。")
                row = selected[0]
                low, q1, q3, high = [float(row[summary[key]]) for key in ("min", "q25", "q75", "max")]
                if not all(np.isfinite([low,q1,q3,high])) or not low <= q1 <= q3 <= high or not low <= height <= high:
                    raise ValueError("分位数、范围或柱高不一致。")
                ax.plot([xpos,xpos], [low,high], color=palette.ink, linewidth=1, zorder=4)
                for cap in (low,high):
                    ax.plot([xpos-width*.13,xpos+width*.13], [cap,cap], color=palette.ink, linewidth=1, zorder=4)
                ax.plot([xpos,xpos], [q1,q3], color=bar_edge_color(palette,index), linewidth=5, zorder=5)
                if "median" in summary:
                    median=float(row[summary["median"]])
                    if not q1 <= median <= q3: raise ValueError("中位数不在四分位区间内。")
                    ax.plot([xpos],[median],linestyle="none",marker="D",markersize=4,markerfacecolor="white",markeredgecolor=palette.ink,zorder=6)
                if "n" in summary:
                    ax.annotate(f"n={row[summary['n']]}",(xpos,high),xytext=(0,7),textcoords="offset points",ha="center",fontsize=7)
            ax.margins(y=.16)
    ax.set_xticks(x, category_order)
    ax.set_xlabel(str(encoding.get("x_label", category_name)))
    ax.set_ylabel(str(encoding.get("y_label", value_name)))
    ax.set_title(str(encoding.get("title", "")))
    if encoding.get("summary_range_columns"):
        center_label = "均值" if value_name == "mean" else value_name
        median_note = "；菱形：中位数" if "median" in encoding["summary_range_columns"] else ""
        ax.set_xlabel(str(encoding.get("x_label", category_name)) + f"\n柱高：{center_label}；粗线：四分位区间；细线：最小—最大{median_note}（非置信区间）", fontsize=8)
    if len(group_order) > 1:
        ax.legend()
    apply_annotations(ax, encoding)
    style_axis(ax, palette)
    return save_figure(fig, output_dir, TEMPLATE_ID, formats, dpi, palette)

