def render(data_file: str, output_dir: str, palette_id: str, formats: list[str], dpi: int) -> list[Path]:
    rows, encoding = load_rows(data_file), CONFIG["encoding"]
    pairs = [(encoding["x1_column"], encoding["y1_column"]), (encoding["x2_column"], encoding["y2_column"])]
    group_name = str(encoding.get("group_column", "")); groups = require_column(rows, group_name) if group_name else ["数据"] * len(rows)
    palette = setup_style(palette_id)
    fig, axes = plt.subplots(1, 2, figsize=tuple(CONFIG["figsize"])); axes = np.atleast_1d(axes)
    for panel, (ax, (xn, yn)) in enumerate(zip(axes, pairs)):
        panel_encoding = dict(encoding)
        panel_lines = encoding.get("panel_reference_lines", [])
        if isinstance(panel_lines, list) and panel < len(panel_lines):
            panel_encoding["reference_lines"] = panel_lines[panel]
        ax.set_facecolor(palette.background); apply_axis_layer(ax, panel_encoding)
        x, y = numeric(require_column(rows, xn), xn), numeric(require_column(rows, yn), yn)
        for index, group in enumerate(ordered_unique(groups)):
            mask = np.asarray([value == group for value in groups], dtype=bool); order = np.argsort(x[mask])
            line_styles = ("-", "--", "-.", ":"); markers = ("o", "s", "^", "D")
            stroke = mix_color(bar_edge_color(palette, index), "#263238", 0.24)
            ax.plot(x[mask][order], y[mask][order], color=stroke, linewidth=1.8,
                    linestyle=line_styles[index % len(line_styles)], marker=markers[index % len(markers)],
                    markersize=3.0, markeredgecolor=stroke, label=group, zorder=3)
        ax.set_xlabel(str(encoding.get(f"x{panel + 1}_label", xn))); ax.set_ylabel(str(encoding.get(f"y{panel + 1}_label", yn)))
        ax.set_title(str(encoding.get(f"panel{panel + 1}_title", yn))); style_axis(ax, palette)
        if encoding.get(f"x{panel + 1}_percent", False):
            ax.xaxis.set_major_formatter(mticker.PercentFormatter(xmax=1.0))
        panel_has_reference = any(str(line.get("label", "")).strip() for line in panel_encoding.get("reference_lines", []) if isinstance(line, dict))
        if len(ordered_unique(groups)) > 1 or panel_has_reference or panel == 1:
            ax.legend()
    return save_figure(fig, output_dir, TEMPLATE_ID, formats, dpi, palette)

